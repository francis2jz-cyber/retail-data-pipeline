# Copy this file to .env and edit. Every line is optional.

# Leave DATABASE_URL commented out to use the built-in SQLite database (data/retail.db).
# To use PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/retail

# Mock Payment API (started automatically by the pipeline)
PAYMENT_API_URL=http://127.0.0.1:8765
PAYMENT_API_PAGE_SIZE=250
AUTO_START_MOCK_API=true

# Payments within this amount of the order total count as matched
AMOUNT_TOLERANCE=0.01

# Payments are only flagged as missing once an order is older than this many days
SETTLEMENT_WINDOW_DAYS=2
# Date to measure order age against (YYYY-MM-DD). Leave empty to use the latest order date.
# AS_OF_DATE=

# Currency orders are priced in. Payments in any other currency are rejected.
BASE_CURRENCY=USD

# ---- Optional: pull payments from a real Paystack TEST account ----
# 1. Free account at https://dashboard.paystack.com, copy the TEST secret key (Settings > API Keys)
# 2. python scripts/seed_paystack_demo.py
# 3. Uncomment these four lines and run python run_pipeline.py
# PAYSTACK_SECRET_KEY=paste_your_test_secret_key_here
# PAYMENT_SOURCE=paystack
# BASE_CURRENCY=ZAR
# RAW_DATA_DIR=data/paystack_demo/raw
